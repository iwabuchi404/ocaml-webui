# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Typed, traceable WebView boundary for OCaml applications"
description: """
An OCaml application runtime that owns the WebView boundary, lifecycle,
dispatch, typed commands, structured errors, and tracing."""
maintainer: ["iwabuchi404"]
authors: ["iwabuchi404"]
license: "MIT"
homepage: "https://github.com/iwabuchi404/ocaml-webui"
doc: "https://github.com/iwabuchi404/ocaml-webui/tree/main/docs"
bug-reports: "https://github.com/iwabuchi404/ocaml-webui/issues"
depends: [
  "ocaml" {>= "5.4" & < "5.5"}
  "dune" {>= "3.18"}
  "yojson" {>= "3.0"}
  "atd" {>= "4.2" & build}
  "atdml" {>= "4.2" & build}
  "atdts" {>= "4.2" & build}
  "conf-c++"
  "conf-mingw-w64-g++-x86_64" {os = "win32" & arch = "x86_64"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/iwabuchi404/ocaml-webui.git"
x-maintenance-intent: ["(latest)"]
depexts: [
  # os-family "debian" covers Debian, Ubuntu and derivatives (Mint, etc.)
  ["build-essential" "pkg-config" "libgtk-3-dev" "libwebkit2gtk-4.1-dev"]
    {os-family = "debian"}
  ["gcc-c++" "make" "pkgconf-pkg-config" "gtk3-devel" "webkit2gtk4.1-devel"]
    {os-distribution = "fedora"}
  # os-family "arch" covers Arch and derivatives (Manjaro, etc.)
  ["base-devel" "pkgconf" "gtk3" "webkit2gtk-4.1"]
    {os-family = "arch"}
]
