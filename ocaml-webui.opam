opam-version: "2.0"
synopsis: "Typed, traceable WebView boundary for OCaml applications"
description: """
An OCaml application runtime that owns the WebView boundary, lifecycle,
dispatch, typed commands, structured errors, and tracing.
"""
maintainer: "Hiro"
authors: "Hiro"
depends: [
  "ocaml" {>= "5.4" & < "5.5"}
  "dune" {>= "3.18"}
  "conf-c++"
  "conf-mingw-w64-g++-x86_64" {os = "win32" & arch = "x86_64"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
