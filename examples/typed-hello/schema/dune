;; bin/commands.ml から生成された hello.atd をこの build dir へコピー
;; (atdml/atdts は入力ファイルの隣に出力するため、先にコピーが必要)
(rule
 (targets hello.atd)
 (deps ../bin/hello.atd)
 (action (copy ../bin/hello.atd hello.atd)))

;; hello.atd から OCaml codec を生成
(rule
 (targets hello.ml hello.mli)
 (deps hello.atd)
 (action (run atdml hello.atd)))

;; hello.atd から TypeScript codec を生成
(rule
 (target hello.ts)
 (deps hello.atd)
 (action (run atdts %{deps})))

(library
 (name hello_schema)
 (libraries yojson)
 (modules hello))
